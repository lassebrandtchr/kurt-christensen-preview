# Kopiér til .env og udfyld. Ingen hemmeligheder i repoet.
PUBLIC_SITE_URL=https://www.kurtchristensen.dk
# Formspree-formularens ID (fx "xyzabcd" fra https://formspree.io/f/xyzabcd)
PUBLIC_FORMSPREE_ID=
# Sanity (valgfrit). Uden SANITY_PROJECT_ID læses bilerne fra src/content/cars/
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Kun nødvendig hvis datasættet er privat (læsetoken, gemmes i hostingens miljøvariabler)
SANITY_READ_TOKEN=

# Preview (fx GitHub Pages). PUBLIC_NOINDEX=true holder hele sitet ude af Google.
# SITE_BASE sættes kun når sitet ligger i en undermappe, fx /kurt-christensen-preview
PUBLIC_NOINDEX=
SITE_BASE=
