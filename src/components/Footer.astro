---
import Logo from './Logo.astro';
import Shield from './Shield.astro';
import Icon from './Icon.astro';
import { SITE, u } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <Shield class="site-footer__shield" strokeWidth={1} />
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo width={260} loading="lazy" alt="Kurt Christensen – vi handler med klassiske og eksklusive biler" />
      <p class="site-footer__cta">Har du fundet drømmebilen? Ring til Kurt – så finder I et tidspunkt, hvor du kan se den.</p>
      <a href={SITE.phoneHref} class="btn btn--primary magnetic"><Icon name="phone" />Ring til Kurt</a>
    </div>
    <div>
      <h2 class="site-footer__h">Besøg showroomet</h2>
      <address>
        Kurt Christensen<br />
        {SITE.street}<br />
        {SITE.postalCode} {SITE.city}
      </address>
      <p><a href={SITE.directionsUrl} rel="noopener" target="_blank">Få rutevejledning</a></p>
    </div>
    <div>
      <h2 class="site-footer__h">Kontakt</h2>
      <p><a href={SITE.phoneHref} class="tabular">Tlf. {SITE.phone}</a></p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p><a href={SITE.facebook} rel="noopener" target="_blank">Kurt på Facebook</a></p>
    </div>
    <nav aria-label="Sidefod">
      <h2 class="site-footer__h">Biler</h2>
      <ul>
        <li><a href={u("/biler-til-salg/")}>Biler til salg</a></li>
        <li><a href={u("/klassiske-biler/")}>Klassiske biler</a></li>
        <li><a href={u("/eksklusive-biler/")}>Eksklusive biler</a></li>
        <li><a href={u("/om-kurt/#solgte-biler")}>Solgte biler</a></li>
        <li><a href={u("/om-kurt/")}>Om Kurt</a></li>
        <li><a href={u("/kontakt/")}>Kontakt</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <span class="site-footer__flag"><Icon name="flag" /> Kurt Christensen · {SITE.street}, {SITE.postalCode} {SITE.city}</span>
    <span>© {year} · <a href={u("/privatlivspolitik/")}>Privatlivspolitik</a></span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--text);
    border-top: 1px solid var(--line);
    padding-top: clamp(56px, 8vw, 112px);
    color-scheme: dark;
    --fg: var(--text);
    --fg-soft: var(--champagne);
    --accent: var(--gold);
    --bg: var(--ink);
  }
  .site-footer :global(.site-footer__shield) {
    position: absolute;
    width: min(1100px, 120vw);
    height: auto;
    aspect-ratio: 1000 / 640;
    left: 50%;
    top: 40px;
    transform: translateX(-50%);
    color: var(--gold);
    opacity: 0.08;
    pointer-events: none;
  }
  .site-footer__grid {
    position: relative;
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .site-footer__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
  .site-footer__brand { display: grid; gap: 20px; justify-items: start; }
  .site-footer__brand :global(img) { width: 240px; height: auto; }
  .site-footer__cta { font-family: var(--f-serif); font-style: italic; font-size: 1.25rem; line-height: 1.4; color: var(--champagne); max-width: 34ch; }
  .site-footer__h {
    font-size: var(--fs-xs);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .site-footer address { font-style: normal; margin-bottom: 10px; }
  .site-footer p + p { margin-top: 6px; }
  .site-footer a { color: var(--text); text-decoration-color: rgba(201, 164, 106, 0.5); }
  .site-footer a:hover { color: var(--champagne); text-decoration-color: var(--gold); }
  .site-footer ul { list-style: none; display: grid; gap: 6px; }
  .site-footer .btn { color: #fff; text-decoration: none; }
  .site-footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--silver-dim);
  }
  .site-footer__flag { display: inline-flex; align-items: center; gap: 10px; }
  .site-footer__flag :global(svg) { width: 20px; height: 20px; color: var(--gold); }
</style>
