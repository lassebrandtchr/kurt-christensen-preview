---
import { Picture } from 'astro:assets';
import Shield from './Shield.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, u } from '../lib/site';

// Hero-billedet synkroniseres af scripts/sync-images.mjs. Mangler det, bruges logoet som hero.
const heroGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/hero-studio.webp', { eager: true });
const hero = Object.values(heroGlob)[0]?.default;
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__frame" data-hero-frame>
      <div class="hero__img" data-hero-img>
        {hero ? (
          <Picture
            src={hero}
            alt="Rød Ferrari 308 GTS fra 1978 i studiet med Kurt Christensens logo på væggen"
            formats={['avif']}
            fallbackFormat="webp"
            widths={[640, 960, 1280, 1536]}
            sizes="(min-width: 1180px) 1080px, 92vw"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            quality={80}
          />
        ) : (
          <div class="hero__logo-fallback"><Logo width={900} alt="Kurt Christensen – vi handler med klassiske og eksklusive biler" /></div>
        )}
      </div>
      <Shield class="hero__shield" strokeWidth={1.25} />
    </div>
  </div>

  <div class="hero__copy container">
    <div class="hero__mark" aria-hidden="true">
      <span class="hero__line hero__line--l" data-hero-line></span>
      <p class="hero__wordmark" data-hero-word>
        <span class="metal-text shine" data-shine-manual><b>KURT</b>&nbsp;<span class="light">CHRISTENSEN</span></span>
      </p>
      <span class="hero__line hero__line--r" data-hero-line></span>
    </div>
    <p class="hero__tagline" data-hero-tag>{SITE.tagline}</p>
    <h1 id="hero-title" class="hero__title" data-hero-h1>Klassiske og eksklusive biler – håndplukket i Bramming</h1>
    <div class="hero__ctas" data-hero-cta>
      <a href={u("/biler-til-salg/")} class="btn btn--gold magnetic">Se biler til salg <Icon name="arrow" /></a>
      <a href={SITE.phoneHref} class="btn btn--primary magnetic"><Icon name="phone" /> Ring til Kurt – <span class="tabular">{SITE.phone}</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto;
    align-content: center;
    gap: clamp(20px, 3vh, 36px);
    padding: calc(var(--header-h) + clamp(12px, 3vh, 32px)) 0 clamp(40px, 7vh, 72px);
    background:
      radial-gradient(ellipse 70% 55% at 50% 38%, rgba(201, 164, 106, 0.08), transparent 70%),
      var(--ink);
    overflow: clip;
  }
  .hero__stage { display: grid; place-items: center; }
  .hero__frame {
    position: relative;
    width: min(92vw, 1080px, max(300px, calc((100svh - 360px) * 1.5625)));
    aspect-ratio: 1000 / 640;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(50% 0.6%, 97.2% 15%, 97.2% 86.9%, 50% 99.4%, 2.8% 86.9%, 2.8% 15%);
    background: var(--ink);
  }
  .hero__img :global(picture) { display: contents; }
  .hero__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
  .hero__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, transparent 55%, rgba(10, 10, 11, 0.45) 100%);
    pointer-events: none;
  }
  .hero__logo-fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: 6%; }
  .hero__logo-fallback :global(img) { width: 100%; height: auto; }
  .hero :global(.hero__shield) {
    position: absolute;
    inset: -14px -16px;
    width: calc(100% + 32px);
    height: calc(100% + 28px);
    color: var(--gold);
    pointer-events: none;
  }

  .hero__copy { display: grid; justify-items: center; text-align: center; gap: 14px; }
  .hero__mark {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(10px, 2vw, 28px);
    width: 100%;
    max-width: 1180px;
  }
  .hero__line { height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); min-width: 16px; }
  .hero__line--l { transform-origin: right center; }
  .hero__line--r { background: linear-gradient(90deg, var(--gold), transparent); transform-origin: left center; }
  .hero__wordmark {
    font-family: var(--f-sans);
    font-style: italic;
    font-stretch: 125%;
    font-size: clamp(1.45rem, 6.2vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    padding: 0.08em 0.1em;
  }
  .hero__wordmark b { font-weight: 800; }
  .hero__wordmark .light { font-weight: 300; }
  .hero__wordmark > span { display: inline-block; }
  @media (max-width: 480px) { .hero__wordmark { font-size: 5.5vw; } }
  .hero__tagline {
    font-size: clamp(0.625rem, 1.6vw, 0.875rem);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--champagne);
  }
  .hero__title {
    margin-top: 6px;
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem);
    line-height: 1.3;
    color: var(--text);
    max-width: 30ch;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 16px; margin-top: 10px; }
  @media (max-width: 520px) {
    .hero__ctas { width: 100%; }
    .hero__ctas .btn { width: 100%; }
  }

  /* Intro-tilstand: sættes inline i <head> kun ved første besøg + JS + ingen reduced motion */
  :global(html.hero-intro) .hero__shield :global(.shield__path) { stroke-dashoffset: 1; }
  :global(html.hero-intro) [data-hero-img] { filter: brightness(0.35); transform: scale(1.04); }
  :global(html.hero-intro) [data-hero-word] > span { transform: translateY(110%); }
  :global(html.hero-intro) [data-hero-line] { transform: scaleX(0); }
  :global(html.hero-intro) [data-hero-tag],
  :global(html.hero-intro) [data-hero-h1],
  :global(html.hero-intro) [data-hero-cta] { opacity: 0; }
</style>

<script>
  import '../scripts/hero.ts';
</script>
