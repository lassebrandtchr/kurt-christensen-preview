---
/**
 * Skematisk, cookie-fri kortillustration (ingen iframe/embed). Viser Bramming i forhold til
 * Esbjerg, Ribe og Vejen. Ikke målfast – til rutevejledning linkes til Google Maps / OpenStreetMap.
 */
import { SITE } from '../lib/site';
---
<figure class="map">
  <svg viewBox="0 0 800 460" role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Skematisk kort: Kurt Christensen, Ribevej 11, 6740 Bramming</title>
    <desc id="map-desc">Bramming ligger øst for Esbjerg og nord for Ribe i Sydvestjylland.</desc>
    <defs>
      <pattern id="map-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M40 0H0V40" fill="none" stroke="#2C2D31" stroke-width="1" />
      </pattern>
      <radialGradient id="map-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#C9A46A" stop-opacity=".35" />
        <stop offset="1" stop-color="#C9A46A" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="800" height="460" fill="#141416" />
    <rect width="800" height="460" fill="url(#map-grid)" />
    <!-- Kystlinje mod vest (stiliseret) -->
    <path d="M0 0 H70 C90 80 60 140 85 200 C110 260 70 320 95 380 C110 420 90 440 100 460 H0 Z" fill="#0A0A0B" />
    <!-- Veje (stiliseret) -->
    <path d="M110 205 C230 210 300 200 400 214 C520 230 600 205 760 196" fill="none" stroke="#3a3b40" stroke-width="6" stroke-linecap="round" />
    <path d="M400 214 C410 280 425 340 445 420" fill="none" stroke="#3a3b40" stroke-width="6" stroke-linecap="round" />
    <path d="M400 214 C410 280 425 340 445 420" fill="none" stroke="#C9A46A" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round" />
    <!-- Byer -->
    <g font-family="Archivo Variable, Archivo, sans-serif" font-size="13" letter-spacing="2.5" fill="#9A9DA3">
      <circle cx="128" cy="205" r="5" fill="#9A9DA3" /><text x="140" y="190">ESBJERG</text>
      <circle cx="445" cy="420" r="5" fill="#9A9DA3" /><text x="460" y="425">RIBE</text>
      <circle cx="740" cy="197" r="5" fill="#9A9DA3" /><text x="660" y="182">VEJEN</text>
      <text x="420" y="320" font-size="11" fill="#6f7277" transform="rotate(76 420 320)">RIBEVEJ</text>
    </g>
    <!-- Bramming / Kurt -->
    <circle cx="400" cy="214" r="70" fill="url(#map-glow)" />
    <path d="M400 168 L428 176 L428 204 L400 214 L372 204 L372 176 Z" fill="#0A0A0B" stroke="#C9A46A" stroke-width="2" />
    <text x="400" y="197" text-anchor="middle" font-family="Archivo Variable, Archivo, sans-serif" font-style="italic" font-weight="800" font-size="15" fill="#ECE9E3">KC</text>
    <g font-family="Archivo Variable, Archivo, sans-serif">
      <text x="400" y="250" text-anchor="middle" font-size="16" font-weight="700" letter-spacing="3" fill="#E8D9BC">BRAMMING</text>
      <text x="400" y="272" text-anchor="middle" font-size="12" letter-spacing="1.5" fill="#9A9DA3">{SITE.street}, {SITE.postalCode} {SITE.city}</text>
    </g>
  </svg>
  <figcaption>
    <span>Skematisk kort – ikke målfast.</span>
    <a href={SITE.directionsUrl} target="_blank" rel="noopener">Rutevejledning i Google Maps</a>
    <a href={SITE.osmUrl} target="_blank" rel="noopener">Åbn i OpenStreetMap</a>
  </figcaption>
</figure>
<style>
  .map { margin: 0; border: 1px solid var(--line); background: var(--charcoal); }
  .map svg { width: 100%; height: auto; }
  .map figcaption { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 14px 18px; font-size: var(--fs-sm); color: var(--silver-dim); border-top: 1px solid var(--line); }
  .map figcaption a { color: var(--champagne); }
</style>
