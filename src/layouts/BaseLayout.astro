---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { autoDealer } from '../lib/schema';
import { SITE, u } from '../lib/site';

interface Props {
  title: string;
  description: string;
  univers?: 'klassisk' | 'eksklusiv' | 'neutral';
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  overlayHeader?: boolean;
  bodyClass?: string;
}
const {
  title,
  description,
  univers = 'neutral',
  ogImage,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  overlayHeader = false,
  bodyClass,
} = Astro.props;
// Preview-tilstand (PUBLIC_NOINDEX=true): hele sitet holdes ude af Google.
const previewNoindex = import.meta.env.PUBLIC_NOINDEX === 'true';

const site = Astro.site ?? new URL('https://www.kurtchristensen.dk');
const canonical = new URL(Astro.url.pathname, site).href;
const og = ogImage ? new URL(ogImage, site).href : new URL(u('/og-default.jpg'), site).href;
const schemas = [autoDealer(site), ...jsonLd];
const themeColor = univers === 'klassisk' ? '#F2EEE6' : '#0A0A0B';
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {previewNoindex ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={u("/sitemap-index.xml")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-univers={univers} class={bodyClass}>
    <a class="skip-link" href="#indhold">Spring til indhold</a>
    <div class="grain" aria-hidden="true"></div>
    <Header overlay={overlayHeader} />
    <main id="indhold" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
